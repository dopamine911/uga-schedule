{
  "name": "studio-scheduling",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @studio/api --filter @studio/web dev",
    "db:reset": "pnpm --filter @studio/api db:reset",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "doctor": "react-doctor -y --verbose"
  },
  "devDependencies": {
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "react-doctor": "^0.9.23"
  }
}
