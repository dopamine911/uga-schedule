{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "endOfLine": "lf",
  "semi": false,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 80,
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "packages/web/src/index.css",
    "functions": ["cn", "cva"]
  },
  "ignorePatterns": [
    "pnpm-lock.yaml",
    "packages/api/drizzle/",
    "specs/",
    ".agents/",
    ".claude/"
  ]
}
